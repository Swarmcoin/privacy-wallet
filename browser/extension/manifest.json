{
  "manifest_version": 3,
  "name": "SWARM Wallet",
  "short_name": "SWARM Wallet",
  "version": "0.2.2",
  "description": "Shielded SWM wallet. Your keys never enter the browser: the extension talks to the SWARM wallet host on this computer.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["nativeMessaging", "storage", "sidePanel"],
  "host_permissions": ["https://wallet.swarm.green/api/price/swm"],
  "action": {
    "default_title": "SWARM Wallet",
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icons/wallet-128.png"
    }
  },
  "icons": {
    "128": "icons/wallet-128.png",
    "192": "icons/wallet-192.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src https://wallet.swarm.green; img-src 'self' data:; font-src 'self'; style-src 'self'"
  },
  "content_scripts": [],
  "web_accessible_resources": [],
  "externally_connectable": {
    "ids": ["gjmgdanakkpkgpmecnecoliifonlapnb"]
  }
}
